# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Azure SQL Database (used by Prisma)
# Example: sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://localhost:1433;database=closetspacecomics;user=sa;password=changeme;encrypt=true;trustServerCertificate=true"

# Azure Blob Storage (comic/issue/photo images)
AZURE_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
AZURE_STORAGE_CONTAINER=comic-images

# Auth0 (API authorization)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.closetspacecomics.com
